{
	"schemaVersion": 1,
	"id": "diorama",
	"version": "${version}",
	"name": "Mappa Mundi",
	"description": "A ray-traced, angled voxel map and minimap, painted like an old atlas: a book of settings over the world map, banner waypoints, drifting clouds, coasts and day and night. A fork of Diorama by Dara Adedeji.",
	"authors": [
		"Konrad Reinhardt",
		"Dara Adedeji"
	],
	"contact": {
		"homepage": "https://github.com/KonradReinhardt/diorama",
		"sources": "https://github.com/KonradReinhardt/diorama",
		"issues": "https://github.com/KonradReinhardt/diorama/issues"
	},
	"license": "MIT",
	"icon": "assets/diorama/icon.png",
	"environment": "client",
	"entrypoints": {
	    "modmenu": ["dev.diorama.fabric.DioramaModMenu"],
		"client": [
			"dev.diorama.fabric.DioramaFabric"
		]
	},
	"depends": {
		"fabricloader": ">=${loader}",
		"minecraft": "${minecraft}",
		"java": ">=${java}",
		"fabric-api": "*"
	},
	"suggests": { "modmenu": "*" },
	"mixins": [
		"diorama.mixins.json"
	]
}
