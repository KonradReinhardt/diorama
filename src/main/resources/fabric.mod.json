{
	"schemaVersion": 1,
	"id": "diorama",
	"version": "${version}",
	"name": "Mappa Mundi",
	"description": "A painted minimap and world map, like an old atlas.",
	"authors": [
		"Konrad Reinhardt",
		"Dara Adedeji"
	],
	"contact": {
		"homepage": "https://github.com/KonradReinhardt/mappa-mundi",
		"sources": "https://github.com/KonradReinhardt/mappa-mundi",
		"issues": "https://github.com/KonradReinhardt/mappa-mundi/issues"
	},
	"license": "MIT",
	"icon": "assets/diorama/icon.png",
	"environment": "client",
	"entrypoints": {
	    "modmenu": ["dev.diorama.fabric.DioramaModMenu"],
		"client": [
			"dev.diorama.fabric.DioramaFabric"
		]
	},
	"depends": {
		"fabricloader": ">=${loader}",
		"minecraft": "${minecraft}",
		"java": ">=${java}",
		"fabric-api": "*"
	},
	"suggests": { "modmenu": "*" },
	"mixins": [
		"diorama.mixins.json"
	]
}
